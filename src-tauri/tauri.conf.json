{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurora Music",
  "version": "0.2.0-beta.14",
  "identifier": "com.pajeeh.aurora",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aurora Music",
        "url": "https://pajeeh.github.io/aurora-music/?source=windows",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Music",
    "shortDescription": "Sua música. Suas regras.",
    "longDescription": "Aurora Music é uma experiência musical social com reprodução oficial pelo YouTube, biblioteca, playlists e integração com Discord.",
    "copyright": "© 2026 Luis Santos",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
